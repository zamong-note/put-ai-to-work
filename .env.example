# 복사해서 .env 로 저장 후 값 채우기 (.env는 절대 공유/커밋하지 말 것)

# ── 브로커 ── sim: 오프라인 시뮬레이터 / kis: 한국투자증권 모의투자 / kis_real: 실전 계좌(실제 돈)
BROKER=sim
# 실전(kis_real)은 아래 값까지 yes 여야 켜진다. 등록된 규칙·자동 투자가 확인 없이 실제 돈으로 체결됨.
# KIS_REAL_TRADING=yes

# 한국투자증권 KIS Open API — https://apiportal.koreainvestment.com (모의/실전 앱키는 서로 다름)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=12345678
KIS_ACCOUNT_PRODUCT=01

# ── 텔레그램 봇 ── @BotFather 로 봇 생성 후 토큰. CHAT_ID를 비워 두면 첫 /start 때 콘솔에 출력됨
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Sheets 매매일지 (선택) ── 서비스 계정 JSON 경로 + 시트 ID (시트를 서비스 계정 이메일에 편집자로 공유)
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# ── Claude ── 비워 두면 Claude Code 로그인 정보를 사용
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ── 밖에서 접속 (Cloudflare Tunnel + Access, 무료) ── run --public 일 때만 사용. 설정 방법은 README "밖에서 접속하기"
# 공개 주소 (Tunnel 에서 만든 Published application 의 Hostname)
DASHBOARD_PUBLIC_HOST=
# Access 팀 이름(xxx.cloudflareaccess.com 의 xxx)과 앱 AUD 태그 — 둘 다 있으면 이메일 로그인 토큰을 프로그램이 직접 검증
CF_ACCESS_TEAM=
CF_ACCESS_AUD=
# (선택) 들어올 수 있는 이메일만 한 번 더 제한
ACCESS_ALLOWED_EMAILS=

# ── AI 투자 점검용 미국 금리·VIX (선택) ── https://fred.stlouisfed.org/docs/api/api_key.html 에서 무료 발급
# 비워 두면 환율·World Bank 경제지표·시장 흐름만으로 점검
FRED_API_KEY=

# ── 휴대폰 접속 PIN (run --lan 일 때만 사용, 6~12자리 숫자) ── 비우면 실행할 때마다 새 PIN을 터미널에 표시
DASHBOARD_PIN=

# ── PDF 보고서 메일 (선택) ── Gmail: smtp.gmail.com / 587 / 계정 / 앱 비밀번호(Google 계정 > 보안 > 앱 비밀번호)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 받을 주소 (비우면 SMTP_USER, 쉼표로 3개까지)
REPORT_EMAIL_TO=
